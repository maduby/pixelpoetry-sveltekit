{
	"name": "pixelpoetry-sveltekit",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --host 0.0.0.0",
		"prebuild": "pnpm editorial:touch:changed",
		"build": "node scripts/build-images.mjs && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"editorial:touch": "node scripts/update-editorial-timestamps.mjs",
		"editorial:touch:changed": "node scripts/update-editorial-timestamps.mjs --changed",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@fontsource/arvo": "^5.2.7",
		"@fontsource/lato": "^5.2.7",
		"@sveltejs/adapter-vercel": "^6.3.3",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^24",
		"@types/topojson-client": "^3.1.5",
		"blurhash": "^2.0.5",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"sharp": "^0.34.5",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.0.7"
	},
	"engines": {
		"node": "24.x",
		"pnpm": ">=10.0.0"
	},
	"dependencies": {
		"@observablehq/plot": "^0.6.17",
		"@rodneylab/svelte-social-icons": "^0.0.31",
		"@types/d3": "^7.4.3",
		"@use-gesture/vanilla": "^10.3.1",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"d3": "^7.9.0",
		"gsap": "^3.15.0",
		"lottie-web": "^5.13.0",
		"lucide-svelte": "^1.0.1",
		"posthog-js": "^1.373.4",
		"svelte-sonner": "^1.1.1",
		"tailwind-merge": "^3.6.0",
		"topojson-client": "^3.1.0"
	}
}
