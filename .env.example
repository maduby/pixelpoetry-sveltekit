# --------------------------------------------------------------------
# Pixel Poetry — environment variables
#
# Copy this file to `.env` (gitignored) and fill in the placeholders.
# Production values are configured in the Vercel project dashboard.
# --------------------------------------------------------------------

# PostHog analytics — cookie-free, memory-only persistence.
# Create a new project for pixelpoetry.dev at https://eu.posthog.com/settings/project
# and paste its public key here.
PUBLIC_POSTHOG_KEY=phc_REPLACE_WITH_YOUR_PIXELPOETRY_PROJECT_KEY
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# PostHog personal API key — only needed to run scripts/create-posthog-dashboard.mjs
# Get yours at https://eu.posthog.com/settings/user-api-keys
POSTHOG_PERSONAL_API_KEY=your_posthog_personal_api_key
