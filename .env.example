# --------------------------------------------------------------------
# Pixel Poetry — environment variables
#
# Copy this file to `.env` (gitignored) and fill in the placeholders.
# Production values are configured in the Vercel project dashboard.
# --------------------------------------------------------------------

# PostHog analytics — cookie-free, memory-only persistence.
# Create a new project for pixelpoetry.dev at https://eu.posthog.com/settings/project
# and paste its public key here.
PUBLIC_POSTHOG_KEY=phc_REPLACE_WITH_YOUR_PIXELPOETRY_PROJECT_KEY
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# PostHog personal API key — only needed to run scripts/create-posthog-dashboard.mjs
# Get yours at https://eu.posthog.com/settings/user-api-keys
POSTHOG_PERSONAL_API_KEY=your_posthog_personal_api_key

# Neon Postgres — local development should use the Neon `local` branch.
# Use the pooled URL for app runtime and the direct/unpooled URL for migrations.
# Vercel Preview `staging` and Production `main` use separate Vercel env vars.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/pixelpoetry?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.region.aws.neon.tech/pixelpoetry?sslmode=require

# Better Auth — generate the secret with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=replace_with_at_least_32_random_characters
BETTER_AUTH_URL=http://localhost:5173

# Google OAuth — authorized redirect URI:
# http://localhost:5173/api/auth/callback/google
# Production: https://pixelpoetry.dev/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
