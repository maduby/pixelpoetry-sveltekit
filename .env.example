# --------------------------------------------------------------------
# Pixel Poetry — environment variables
#
# Copy this file to `.env` (gitignored) and fill in the placeholders.
# Production values are configured in the Vercel project dashboard.
# --------------------------------------------------------------------

# PostHog analytics — cookie-free, memory-only persistence.
# Create a new project for pixelpoetry.dev at https://eu.posthog.com/settings/project
# and paste its public key here.
PUBLIC_POSTHOG_KEY=phc_REPLACE_WITH_YOUR_PIXELPOETRY_PROJECT_KEY
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# PostHog personal API key — only needed to run scripts/create-posthog-dashboard.mjs
# Get yours at https://eu.posthog.com/settings/user-api-keys
POSTHOG_PERSONAL_API_KEY=your_posthog_personal_api_key

# Neon Postgres — local development should use the Neon `local` branch.
# Use the pooled URL for app runtime and the direct/unpooled URL for migrations.
# Vercel Preview `staging` and Production `main` use separate Vercel env vars.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/pixelpoetry?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.region.aws.neon.tech/pixelpoetry?sslmode=require

# Neon migration workflow — never apply production migrations without first
# running a disposable branch verification from the target branch.
NEON_API_KEY=your_neon_api_key
NEON_PROJECT_ID=your_neon_project_id
NEON_DATABASE_NAME=pixelpoetry
NEON_ROLE_NAME=your_neon_role
NEON_STAGING_BRANCH=staging

# Better Auth — generate the secret with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=replace_with_at_least_32_random_characters
BETTER_AUTH_URL=http://localhost:5173

# Google OAuth — authorized redirect URI:
# http://localhost:5173/api/auth/callback/google
# Production: https://pixelpoetry.dev/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Saved-insights AI recaps.
AI_PROVIDER=minimax

# Direct MiniMax API — uses MiniMax's OpenAI-compatible endpoint.
MINIMAX_API_KEY=your_minimax_api_key
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_BASE_URL=https://api.minimax.io/v1

# Vercel AI Gateway fallback/alternative.
# MiniMax M2.7 is available through Gateway as minimax/minimax-m2.7.
# Auth can use AI_GATEWAY_API_KEY locally, or VERCEL_OIDC_TOKEN when pulled/provisioned by Vercel.
AI_GATEWAY_API_KEY=your_vercel_ai_gateway_key
AI_GATEWAY_MODEL=minimax/minimax-m2.7

# Source grounding for recaps.
# Keep embeddings disabled until a compatible OpenAI-style embedding endpoint is configured.
# Retrieval still works with lexical/source-ID matching when embeddings are disabled.
SOURCE_EMBEDDINGS_ENABLED=false
EMBEDDING_API_KEY=your_embedding_provider_key
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Resend — private email-to-self for saved-insight summaries.
# Use a verified sender on postman.pixelpoetry.dev in production.
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL="Pixel Poetry <summaries@postman.pixelpoetry.dev>"
